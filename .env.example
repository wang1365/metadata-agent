# Copy to .env and fill local values. Never commit .env.
BAILIAN_API_KEY=YOUR_BAILIAN_API_KEY
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
METADATA_MODEL=deepseek-v4.1-flash
# Development launcher ports (start-dev.sh).
METADATA_API_PORT=8000
METADATA_UI_PORT=5173
# Independent queue concurrency (1-8 each); restart to apply.
METADATA_ANALYSIS_CONCURRENCY=1
METADATA_QA_CONCURRENCY=1
# Optional: absolute data directory; default is project/data.
# METADATA_DATA_DIR=D:/path/to/local/data
# Optional Fernet key. If omitted, local testing generates data/.master.key.
# METADATA_MASTER_KEY=YOUR_FERNET_KEY
